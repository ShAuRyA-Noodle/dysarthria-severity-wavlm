{
  "schema": "veritas-bench/1.0",
  "config": {
    "seed": 42,
    "device": "cuda:0",
    "primary_corpus": "torgo",
    "reference_corpora": [
      "ipvs",
      "easycall"
    ],
    "per_speaker_cap_probe_transfer": 80,
    "atd_full_utterances": true,
    "feature": "frozen WavLM-Large; ATD layers {9,1} PCA-64 DTW; probe L9 mean-pool",
    "notes": "ATD score-based tests use ALL TORGO utterances (reproduce the committed headline); probe + cross-corpus transfer use an 80-utt per-speaker cap (matches CX_cross_corpus_severity.py)."
  },
  "thresholds": {
    "alpha": 0.05,
    "predictive_validity": {
      "PASS": "rho >= 0.5 and p < 0.05",
      "WARN": "rho >= 0.3",
      "FAIL": "rho < 0.3",
      "stat": "within-corpus leave-one-speaker-out Spearman rho (metric vs severity)"
    },
    "leakage_loco": {
      "PASS": "naive-minus-LOCO delta <= 0.05",
      "WARN": "delta <= 0.15",
      "FAIL": "delta > 0.15",
      "NA": "metric is not reference-based",
      "stat": "rho(naive reference) - rho(leave-one-control-out reference)"
    },
    "silence_confound": {
      "PASS": "speech-only retains >= 0.7 of full rho AND silence_fraction < 0.5",
      "WARN": "retains >= 0.4, or majority-silence representation",
      "FAIL": "speech-only retains < 0.4 of full rho",
      "stat": "retention = rho(speech-only) / rho(full); plus mean silence frame fraction"
    },
    "energy_confound": {
      "PASS": "partial rho retains >= 0.7 of raw rho",
      "WARN": "retains >= 0.4",
      "FAIL": "retains < 0.4",
      "stat": "partial Spearman(metric, severity | mean speech energy) vs raw Spearman"
    },
    "cross_corpus_transfer": {
      "PASS": "transfer rho >= 0.5 and p < 0.05",
      "WARN": "rho >= 0.3 and p < 0.05",
      "FAIL": "rho < 0.3 or not significant",
      "NA": "fewer than 2 corpora available, or metric exposes no representation",
      "stat": "train probe on other corpora -> test held-out corpus; speaker Spearman"
    },
    "leakage_by_layer": {
      "PASS": "speaker-identity AUC <= 0.7",
      "WARN": "AUC <= 0.85",
      "FAIL": "AUC > 0.85 (representation strongly encodes identity)",
      "stat": "macro one-vs-rest speaker-classification AUC of the metric's representation"
    }
  },
